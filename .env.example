# Ako je .env bio u repozitorijumu: rotiraj Supabase i Turnstile ključeve u dashboard-ima, zatim ažuriraj lokalni .env i Vercel env vars.

# Kopiraj u .env i na Vercelu (Settings → Environment Variables).
# Supabase (već koristiš):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Opciono: override ličnog LinkedIn profila (podrazumevano zdravko-mijailovic-md-phd-rdcs-facc)
# VITE_LINKEDIN_URL=https://www.linkedin.com/in/tvoj-profil

# Opciono: override ličnog X profila (podrazumevano @mdzdravko)
# VITE_X_URL=https://x.com/tvoj_handle

# FormSubmit: prima poruke sa kontakt forme na hello@mdzdravko.com (Zoho).
# Podrazumevano se koristi hello@mdzdravko.com; posle aktivacije možeš staviti hash iz FormSubmit mejla.
# VITE_FORMSUBMIT_ID=hello@mdzdravko.com

# Google Analytics 4 — Measurement ID iz GA konzole (izgleda kao G-XXXXXXXXXX).
# Već postavljeno na Vercelu kao NEXT_PUBLIC_GA_ID (vite.config.js je konfigurisan da prihvati ovaj prefiks).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Cloudflare Turnstile (contact form)
# Site key — exposed to the browser (Vercel + local .env)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key — server only (Vercel, never commit real value)
# Mora biti Secret Key ISTOG widgeta kao NEXT_PUBLIC_TURNSTILE_SITE_KEY (isti par u Cloudflare dashboardu).
TURNSTILE_SECRET_KEY=

# Turnstile hostnames (Cloudflare dashboard → Turnstile → tvoj widget → Settings):
# mdzdravko.com, www.mdzdravko.com, localhost, 127.0.0.1
# Bez localhost widget na npm run dev (5173) prikazuje "Unable to connect to website".
# Lokalni API: `vercel dev` (vite sam ne servira /api/contact).
