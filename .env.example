# Kopiraj u .env i na Vercelu (Settings → Environment Variables).
# Supabase (već koristiš):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Opciono: zameni podrazumevani LinkedIn (MedExNews) ličnim profilom
# VITE_LINKEDIN_URL=https://www.linkedin.com/in/tvoj-profil

# Opciono: X (Twitter) — podrazumevano je @medexnews; zameni ličnim profilom po želji
# VITE_X_URL=https://x.com/tvoj_handle

# FormSubmit: hash iz aktivacionog mejla (umesto golog mejla u /ajax/...); podrazumevana vrednost je u kodu
# VITE_FORMSUBMIT_ID=9ef527932da0d9ce7f458f4a9e74ec93

# Google Analytics 4 — Measurement ID iz GA konzole (izgleda kao G-XXXXXXXXXX).
# Postavi ovu vrednost na Vercelu: Settings → Environment Variables → VITE_GA_ID
# Bez ove vrednosti GA se NEĆE učitati (sajt i dalje radi normalno, samo bez analitike).
# VITE_GA_ID=G-XXXXXXXXXX
